{
  "name": "harmony-site-colors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive generator for website color schemes built on classic color harmony rules, with WCAG-aware design tokens.",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm verify",
    "verify": "node scripts/verify-export.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
